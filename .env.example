# Database PostgreSQL, misalnya URL dari Render PostgreSQL.
DATABASE_URL=postgresql://username:password@host:5432/database
# Gunakan secret acak panjang (minimal 32 karakter).
SESSION_SECRET=ganti_dengan_secret_acak_panjang
OPENAI_API_KEY=isi_api_key_openai
# Pilih model yang tersedia pada akun API kamu.
OPENAI_MODEL=gpt-4.1-mini
# Email admin awal dan token bootstrap admin. Jangan dibagikan.
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_TOKEN=ganti_dengan_token_rahasia_bootstrap
# Untuk deploy HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE=false
PORT=3000
